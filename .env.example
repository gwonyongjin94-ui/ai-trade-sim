# 이 파일을 .env 로 복사하고 키를 직접 넣으세요. .env 는 git에 올라가지 않습니다.
# 앱은 셸 환경변수가 아니라 이 파일의 키만 씁니다.
ANTHROPIC_API_KEY=

# 선택: 다른 회사 모델과 비교 (OpenAI 호환 API)
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_MODELS=gpt-5.1,gpt-5-mini

# 선택: Claude 서버 측 폴백 끄기 (모델 비교를 엄격하게 할 때)
# LLM_FALLBACKS=off

# 무료 로컬 모델 (Ollama). 키가 필요 없고, 설치된 모델은 자동으로 목록에 뜬다. 아래는 바꿀 때만.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=16384
# OLLAMA_THINK=on   # 사고 모드가 있는 모델(qwen3.5, gemma4 등)이 답 전에 따로 생각하게 함. 기본은 끔
